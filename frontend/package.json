    "test": "vitest"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "27.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "engines": { "node": ">=24" }
}
