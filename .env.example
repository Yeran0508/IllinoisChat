APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

POSTGRES_DB=illinoischat
POSTGRES_USER=illinoischat
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
REDIS_HOST=redis
REDIS_PORT=6379

CHUNK_MAX_CHARACTERS=1200
CHUNK_OVERLAP_CHARACTERS=150
DOCUMENT_STORAGE_PATH=data/uploads
MAX_UPLOAD_BYTES=20971520
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_PATH=data/models
HNSW_EF_SEARCH=64
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35

LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3:4b
LLM_TIMEOUT_SECONDS=60

# Add real provider keys only to .env. Never commit them.
EMBEDDING_API_KEY=
